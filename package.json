{
  "name": "missao-enade",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x",
    "npm": ">=11 <13"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && npm run validate:content && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "validate:content": "vitest run tests/unit/content.test.ts tests/unit/puzzle-content.test.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.0.0",
    "eslint": "10.14.0",
    "jsdom": "31.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch": "11.0.8"
  }
}