{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contentVersion",
    "mode",
    "phaseId",
    "missionId",
    "attemptId",
    "course",
    "total",
    "correctCount",
    "score",
    "completedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contentVersion": { "type": "string", "minLength": 1 },
    "mode": { "const": "provisional" },
    "phaseId": { "type": "string", "minLength": 1 },
    "missionId": { "enum": ["quick", "normal", "special", "arena"] },
    "attemptId": { "type": "string", "minLength": 1 },
    "course": { "enum": ["CC", "SI", "TADS", "TGTI", "TRC"] },
    "total": { "enum": [3, 5, 10, 20] },
    "correctCount": { "type": "integer", "minimum": 0, "maximum": 20 },
    "score": { "type": "integer", "minimum": 0, "maximum": 2000, "multipleOf": 100 },
    "completedAt": { "type": "string", "minLength": 1 }
  }
}
