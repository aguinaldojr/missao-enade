{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "contentVersion",
    "phaseId",
    "questions"
  ],
  "properties": {
    "mode": {
      "const": "example"
    },
    "contentVersion": {
      "const": "example-1"
    },
    "phaseId": {
      "const": "FASE-EXEMPLO-01"
    },
    "questions": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "classification",
          "courses",
          "example",
          "editorialStatus",
          "context",
          "prompt",
          "options",
          "correctOptionId",
          "explanation",
          "feedbackByOption"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "classification": {
            "enum": [
              "COMUM",
              "CC",
              "SI",
              "TADS",
              "TGTI",
              "TRC"
            ]
          },
          "courses": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "CC",
                "SI",
                "TADS",
                "TGTI",
                "TRC"
              ]
            }
          },
          "example": {
            "const": true
          },
          "editorialStatus": {
            "const": "example"
          },
          "context": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "options": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "text"
              ],
              "properties": {
                "id": {
                  "enum": [
                    "A",
                    "B",
                    "C",
                    "D",
                    "E"
                  ]
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          },
          "correctOptionId": {
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "E"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "feedbackByOption": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "A",
              "B",
              "C",
              "D",
              "E"
            ],
            "properties": {
              "A": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "B": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "C": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "D": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "E": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    }
  }
}