{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "contentVersion",
    "phaseId",
    "questions"
  ],
  "properties": {
    "mode": {
      "enum": [
        "example",
        "provisional",
        "pilot",
        "approved"
      ]
    },
    "contentVersion": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "phaseId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "classification",
          "courses",
          "context",
          "prompt",
          "options",
          "correctOptionId",
          "explanation",
          "feedbackByOption",
          "collectionId",
          "pedagogicalOrigin",
          "area",
          "competencies",
          "difficulty",
          "source",
          "validationStatus"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "classification": {
            "enum": [
              "COMUM",
              "CC",
              "SI",
              "TADS",
              "TGTI",
              "TRC"
            ]
          },
          "courses": {
            "$ref": "urn:n9:editorial#/definitions/courses"
          },
          "example": {
            "type": "boolean"
          },
          "editorialStatus": {
            "enum": [
              "example",
              "provisional",
              "pilot",
              "approved"
            ]
          },
          "context": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "options": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "text"
              ],
              "properties": {
                "id": {
                  "enum": [
                    "A",
                    "B",
                    "C",
                    "D",
                    "E"
                  ]
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          },
          "correctOptionId": {
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "E"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "feedbackByOption": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "A",
              "B",
              "C",
              "D",
              "E"
            ],
            "properties": {
              "A": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "B": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "C": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "D": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "E": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          "collectionId": {
            "$ref": "urn:n9:editorial#/definitions/collectionId"
          },
          "pedagogicalOrigin": {
            "$ref": "urn:n9:editorial#/definitions/pedagogicalOrigin"
          },
          "area": {
            "$ref": "urn:n9:editorial#/definitions/area"
          },
          "competencies": {
            "$ref": "urn:n9:editorial#/definitions/competencies"
          },
          "difficulty": {
            "$ref": "urn:n9:editorial#/definitions/difficulty"
          },
          "source": {
            "$ref": "urn:n9:editorial#/definitions/source"
          },
          "validationStatus": {
            "$ref": "urn:n9:editorial#/definitions/validationStatus"
          }
        }
      }
    }
  }
}
