{
  "$id": "urn:n9:editorial",
  "definitions": {
    "collectionId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "pedagogicalOrigin": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "courses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "CC",
          "SI",
          "TADS",
          "TGTI",
          "TRC"
        ]
      }
    },
    "area": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "competencies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "difficulty": {
      "enum": [
        "introductory",
        "intermediate",
        "advanced"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "type",
        "description"
      ],
      "properties": {
        "role": {
          "enum": [
            "primary",
            "normative-complementary",
            "technical"
          ]
        },
        "type": {
          "enum": [
            "official-reference",
            "institutional",
            "authorial",
            "fictional"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "url": {
          "type": "string",
          "format": "http-url"
        },
        "year": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999
        },
        "documentId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/source"
      }
    },
    "traceability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "objective",
        "locators"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "locators": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "validationStatus": {
      "enum": [
        "draft",
        "under-ai-review",
        "needs-revision",
        "ready-for-pilot",
        "ready-for-release",
        "rejected"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collectionId",
        "pedagogicalOrigin",
        "courses",
        "area",
        "competencies",
        "difficulty",
        "sources",
        "validationStatus"
      ],
      "properties": {
        "collectionId": {
          "$ref": "#/definitions/collectionId"
        },
        "pedagogicalOrigin": {
          "$ref": "#/definitions/pedagogicalOrigin"
        },
        "courses": {
          "$ref": "#/definitions/courses"
        },
        "area": {
          "$ref": "#/definitions/area"
        },
        "competencies": {
          "$ref": "#/definitions/competencies"
        },
        "difficulty": {
          "$ref": "#/definitions/difficulty"
        },
        "sources": {
          "$ref": "#/definitions/sources"
        },
        "traceability": {
          "$ref": "#/definitions/traceability"
        },
        "validationStatus": {
          "$ref": "#/definitions/validationStatus"
        }
      }
    }
  }
}
