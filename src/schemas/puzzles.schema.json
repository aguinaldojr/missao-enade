{
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "kind",
      "id",
      "title",
      "narrative",
      "collectionId",
      "pedagogicalOrigin",
      "courses",
      "area",
      "competencies",
      "difficulty",
      "blocks",
      "correctOrder",
      "hints",
      "explanation",
      "reward",
      "unlocks",
      "sources",
      "validationStatus"
    ],
    "properties": {
      "kind": {
        "const": "sequence"
      },
      "id": {
        "type": "string",
        "minLength": 1
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "narrative": {
        "type": "string",
        "minLength": 1
      },
      "pedagogicalOrigin": {
        "$ref": "urn:n9:editorial#/definitions/pedagogicalOrigin"
      },
      "courses": {
        "$ref": "urn:n9:editorial#/definitions/courses"
      },
      "area": {
        "$ref": "urn:n9:editorial#/definitions/area"
      },
      "competencies": {
        "$ref": "urn:n9:editorial#/definitions/competencies"
      },
      "difficulty": {
        "$ref": "urn:n9:editorial#/definitions/difficulty"
      },
      "blocks": {
        "type": "array",
        "minItems": 4,
        "maxItems": 7,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "text"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "correctOrder": {
        "type": "array",
        "minItems": 4,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        },
        "maxItems": 7
      },
      "hints": {
        "type": "array",
        "minItems": 3,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "explanation": {
        "type": "string",
        "minLength": 1
      },
      "reward": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "xp"
        ],
        "properties": {
          "xp": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        }
      },
      "unlocks": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mapId",
          "objectId"
        ],
        "properties": {
          "mapId": {
            "type": "string",
            "minLength": 1
          },
          "objectId": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "sources": {
        "$ref": "urn:n9:editorial#/definitions/sources"
      },
      "traceability": {
        "$ref": "urn:n9:editorial#/definitions/traceability"
      },
      "validationStatus": {
        "$ref": "urn:n9:editorial#/definitions/validationStatus"
      },
      "collectionId": {
        "$ref": "urn:n9:editorial#/definitions/collectionId"
      }
    }
  }
}
